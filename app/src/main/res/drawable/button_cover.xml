    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#40FFFFFF" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
