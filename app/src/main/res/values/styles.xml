<?xml version="1.0" encoding="utf-8"?>
<!-- One look for every screen: colours come from colors.xml, sizes from here. -->
<resources>

    <!-- ===== Themes ===== -->

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <!-- Full-screen colourful pages: lockout, pause, sleep, alarm. -->
    <style name="CoverTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ===== Layout pieces ===== -->

    <!-- Every screen: 16dp side margins, a little more air at the top and bottom. -->
    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_xl</item>
        <item name="android:paddingBottom">@dimen/space_xxl</item>
    </style>

    <!-- Cards sit 12dp apart and have 16dp inside. -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_l</item>
    </style>

    <!-- The first card under a page title gets more room. -->
    <style name="Card.First">
        <item name="android:layout_marginTop">@dimen/space_xl</item>
    </style>

    <style name="CoverPage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:paddingTop">@dimen/space_xxl</item>
        <item name="android:paddingBottom">@dimen/space_xxl</item>
    </style>

    <!-- ===== Text ===== -->

    <style name="Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- A big number, e.g. the streak or the grade. -->
    <style name="Display" parent="Title">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Small capitals at the top of a card. Give it an icon with android:drawableStart. -->
    <style name="Heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:drawableTint">@color/accent</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Cover page text (white on colour) -->
    <style name="CoverIcon">
        <item name="android:layout_width">@dimen/icon_cover</item>
        <item name="android:layout_height">@dimen/icon_cover</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:tint">@color/on_cover</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CoverTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_cover</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CoverBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:textColor">@color/on_cover</item>
        <item name="android:textSize">88sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CoverBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/on_cover</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="CoverQuote" parent="CoverBody">
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="CoverCaption" parent="CoverBody">
        <item name="android:textColor">@color/on_cover_soft</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- ===== Buttons ===== -->

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:drawableTint">#FFFFFF</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Text-only button. Lines up with the card's text (no left padding). -->
    <style name="SecondaryButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless.Colored">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:drawableTint">@color/accent</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Opens another screen: text with an arrow. -->
    <style name="LinkButton" parent="SecondaryButton">
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
    </style>

    <!-- Opens a password-protected screen: lock, text, arrow. -->
    <style name="LockedLinkButton" parent="LinkButton">
        <item name="android:drawableStart">@drawable/ic_lock</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
    </style>

    <style name="DangerButton" parent="SecondaryButton">
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- White button on cover pages (the main action). -->
    <style name="CoverButton" parent="PrimaryButton">
        <item name="android:layout_marginTop">@dimen/space_xxl</item>
        <item name="android:background">@drawable/button_cover</item>
        <item name="android:textColor">#10201A</item>
        <item name="android:drawableTint">#10201A</item>
    </style>

    <!-- Outlined button on cover pages (the second choice). -->
    <style name="GhostButton" parent="PrimaryButton">
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@color/on_cover</item>
    </style>

    <!-- Small, quiet text button on cover pages (emergency options). -->
    <style name="CoverLink" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:textColor">@color/on_cover_soft</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
