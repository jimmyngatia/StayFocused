<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout style="@style/Page">

        <TextView style="@style/Title" android:text="Status settings" />

        <TextView style="@style/Subtitle" android:text="Rules for WhatsApp status. Changing them needs the password." />

        <LinearLayout style="@style/Card.First">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_chat" android:text="Every day" />

            <TextView style="@style/FieldLabel" android:text="Daily status limit (minutes)" />
            <EditText android:id="@+id/dailyLimit" style="@style/Field" android:inputType="number" />

            <TextView style="@style/FieldLabel" android:text="Allowed times (24-hour, separate with commas)" />
            <EditText android:id="@+id/windows" style="@style/Field" android:hint="19:00-21:00, 12:30-13:00" android:inputType="text" />

            <TextView style="@style/FieldLabel" android:text="Lockout after being blocked (minutes)" />
            <EditText android:id="@+id/lockout" style="@style/Field" android:inputType="number" />

            <TextView style="@style/FieldLabel" android:text="Breathing pause before status (seconds, 0 = off)" />
            <EditText android:id="@+id/pauseSeconds" style="@style/Field" android:inputType="number" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_sun" android:text="Relaxed days" />

            <TextView style="@style/Caption" android:text="On these days the allowed times are ignored and the relaxed limit is used instead." />

            <LinearLayout
                android:id="@+id/relaxedDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView style="@style/FieldLabel" android:text="Relaxed day limit (minutes)" />
            <EditText android:id="@+id/relaxedLimit" style="@style/Field" android:inputType="number" />
        </LinearLayout>

        <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_marginTop="@dimen/space_xl" android:text="Save" />
    </LinearLayout>
</ScrollView>
