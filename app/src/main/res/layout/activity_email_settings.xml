<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout style="@style/Page">

        <TextView style="@style/Title" android:text="Auto-email report" />

        <TextView
            style="@style/Subtitle"
            android:text="Every week, Status Guard emails your report (message + PDF) to the people you choose, through Gmail." />

        <LinearLayout style="@style/Card.First">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_mail" android:text="One-time Gmail setup (3 minutes)" />

            <TextView
                style="@style/Body"
                android:lineSpacingMultiplier="1.2"
                android:text="1. Use a Gmail account (a separate one just for this is best).\n2. Turn on 2-Step Verification: myaccount.google.com → Security.\n3. Open myaccount.google.com/apppasswords\n4. Create an app password named &quot;Status Guard&quot;.\n5. Copy the 16-letter code into &quot;App password&quot; below.\n\nYour normal Gmail password will NOT work here." />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_key" android:text="Sender" />

            <TextView style="@style/FieldLabel" android:text="Gmail address" />
            <EditText android:id="@+id/sender" style="@style/Field" android:hint="you@gmail.com" android:inputType="textEmailAddress" />

            <TextView style="@style/FieldLabel" android:text="App password" />
            <EditText android:id="@+id/appPassword" style="@style/Field" android:inputType="textPassword" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_share" android:text="Recipients &amp; schedule" />

            <TextView style="@style/FieldLabel" android:text="Send to: your accountability partners (separate with commas)" />
            <EditText
                android:id="@+id/recipients"
                style="@style/Field"
                android:hint="peter@gmail.com, mary@gmail.com"
                android:inputType="textEmailAddress|textMultiLine" />

            <TextView style="@style/FieldLabel" android:text="Day" />
            <Spinner
                android:id="@+id/day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/FieldLabel" android:text="Time" />
            <TimePicker
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:timePickerMode="spinner" />

            <CheckBox
                android:id="@+id/enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send automatically every week" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_alarm" android:text="Accountability partners" />

            <TextView
                style="@style/Body"
                android:text="The people above are your accountability partners. They get an email if you go back to sleep after a level 3 or 4 alarm, or switch the phone off to escape any alarm. Your name for these emails is set under Account on the home screen." />

            <CheckBox
                android:id="@+id/wakeEmails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email them when I go back to sleep or switch the phone off during an alarm" />
        </LinearLayout>

        <TextView android:id="@+id/lastResult" style="@style/Caption" android:layout_marginTop="@dimen/space_m" />

        <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_marginTop="@dimen/space_xl" android:text="Save" />

        <Button android:id="@+id/testButton" style="@style/SecondaryButton" android:layout_gravity="center_horizontal" android:text="Save and send a test now" />
    </LinearLayout>
</ScrollView>
