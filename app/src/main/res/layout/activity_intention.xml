<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout style="@style/Page">

        <TextView android:id="@+id/titleText" style="@style/Title" />

        <TextView android:id="@+id/alarmText" style="@style/Subtitle" />

        <LinearLayout style="@style/Card.First">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_flag" android:text="One thing that matters" />

            <EditText
                android:id="@+id/input"
                style="@style/Field"
                android:hint="e.g. finish chapter 3"
                android:inputType="textCapSentences|textMultiLine" />
        </LinearLayout>

        <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_marginTop="@dimen/space_xl" android:text="Save" />
    </LinearLayout>
</ScrollView>
