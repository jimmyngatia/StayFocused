<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep time: a calm, dim night screen. Covers everything except the apps you can still use. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/night_sky"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_moon"
            android:tint="@color/night_moon" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:textColor="@color/night_text"
            android:textSize="80sp" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/night_soft"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/sleptText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/night_text"
            android:textSize="@dimen/text_heading" />

        <TextView
            android:id="@+id/sleptCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/night_soft"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/wakeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:drawableStart="@drawable/ic_alarm"
            android:drawablePadding="@dimen/space_s"
            android:drawableTint="@color/night_soft"
            android:gravity="center_vertical"
            android:textColor="@color/night_soft"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/quoteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:alpha="0.9"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/night_text"
            android:textSize="@dimen/text_heading"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/sourceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/night_soft"
            android:textSize="@dimen/text_caption" />

        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/appsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:letterSpacing="0.1"
            android:text="You can still use"
            android:textAllCaps="true"
            android:textColor="@color/night_soft"
            android:textSize="@dimen/text_overline" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/appsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button android:id="@+id/bypassButton" style="@style/CoverLink" android:layout_marginTop="@dimen/space_xl" android:text="Force bypass for 5 minutes" />

        <LinearLayout
            android:id="@+id/bypassBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/CoverBody" android:layout_gravity="center_horizontal" android:text="A force bypass costs you" android:textStyle="bold" />

            <TextView android:id="@+id/costText" style="@style/CoverCaption" android:layout_gravity="center_horizontal" />

            <Button android:id="@+id/bypassConfirmButton" style="@style/GhostButton" android:text="Bypass and cut my streaks" />

            <Button android:id="@+id/bypassCancelButton" style="@style/CoverLink" android:layout_gravity="center_horizontal" android:text="Never mind, back to sleep" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
