<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout style="@style/Page">

        <TextView style="@style/Title" android:text="Account" />

        <TextView
            style="@style/Subtitle"
            android:text="Your name, and the one password that protects every setting." />

        <LinearLayout style="@style/Card.First">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_heart" android:text="Your name" />

            <TextView style="@style/Caption" android:text="Used in the emails to your accountability partners." />
            <EditText android:id="@+id/yourName" style="@style/Field" android:hint="Your name" android:inputType="textPersonName|textCapWords" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView style="@style/Heading" android:drawableStart="@drawable/ic_key" android:text="Password" />

            <TextView style="@style/Caption" android:text="Protects status, social media, sleep, alarms and auto-email. Best chosen by your accountability partner." />

            <TextView android:id="@+id/passwordHint" style="@style/Caption" />

            <TextView style="@style/FieldLabel" android:text="Password (at least 8 characters)" />
            <EditText android:id="@+id/newPassword" style="@style/Field" android:inputType="textPassword" />

            <TextView style="@style/FieldLabel" android:text="Type it again" />
            <EditText android:id="@+id/confirmPassword" style="@style/Field" android:inputType="textPassword" />
        </LinearLayout>

        <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_marginTop="@dimen/space_xl" android:text="Save" />
    </LinearLayout>
</ScrollView>
